# Copy to .env.probe in the repo root (gitignored, matched by the existing
# .env* pattern) and fill in real values. Never commit the filled-in file.
#
#   cp scripts/.env.probe.example .env.probe

SUPABASE_URL=https://lmtgwekuqzhfewspnldq.supabase.co
SUPABASE_ANON_KEY=

# Five fixtures, not four — see probe-rls.sh's header for what each one is
# seated with and why. correct_only has no old-role equivalent; it's a
# dedicated test user (probe-correct-only@novacore.test).
QUANTITIES_PASSWORD=
FULL_PASSWORD=
VIEWER_PASSWORD=
READONLY_PASSWORD=
CORRECT_ONLY_PASSWORD=

# Optional — default to the seeded test accounts if unset.
# QUANTITIES_EMAIL=field@novacore.test
# FULL_EMAIL=pm@novacore.test
# VIEWER_EMAIL=cfo@novacore.test
# READONLY_EMAIL=owner@novacore.test
# CORRECT_ONLY_EMAIL=probe-correct-only@novacore.test
